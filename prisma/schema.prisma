// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id              String    @id @default(cuid())
  custoEUR        Float?
  custoBRL        Float?
  data            DateTime
  descricao       String
  categoria       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Campos de parcelamento
  parcelado       Boolean   @default(false)
  numeroParcelas  Int?
  parcelaAtual    Int?
  parcelamentoId  String?   // ID para agrupar parcelas do mesmo pagamento
  dataInicio      DateTime? // Data da primeira parcela
  dataFim         DateTime? // Data da última parcela
}

// Categoria de orçamento: limite mensal definido como % do salário do mês
model Categoria {
  id          String   @id @default(cuid())
  nome        String   @unique
  percentagem Float
  createdAt   DateTime @default(now())
}

// Salário mensal em EUR. "mes" no formato YYYY-MM; um mês sem registo usa o anterior mais recente
model Salario {
  mes   String @id
  valor Float
}
